{
  "consumer": { "name": "payment-orchestrator" },
  "provider": { "name": "ledger-service" },
  "interactions": [
    {
      "type": "Synchronous/HTTP",
      "key": "create-hold-insufficient-funds",
      "description": "create hold: insufficient funds",
      "pending": false,
      "request": {
        "method": "POST",
        "path": "/v1/holds",
        "headers": { "Content-Type": ["application/json"] },
        "body": {
          "content": { "holdId": "0192f0e4-6b1d-7c3a-9a55-4c1f3b2e9d10", "amountMinor": 12345 },
          "contentType": "application/json",
          "encoded": false
        },
        "matchingRules": {
          "body": {
            "$.holdId": { "combine": "AND", "matchers": [{ "match": "type" }] },
            "$.amountMinor": { "combine": "AND", "matchers": [{ "match": "integer" }] }
          }
        }
      },
      "response": {
        "status": 422,
        "headers": { "Content-Type": ["application/problem+json"] },
        "body": {
          "content": { "code": "INSUFFICIENT_FUNDS" },
          "contentType": "application/problem+json",
          "encoded": false
        },
        "matchingRules": {
          "header": {
            "Content-Type": { "combine": "AND", "matchers": [{ "match": "regex", "regex": "application/problem\\+json.*" }] }
          }
        }
      }
    }
  ],
  "metadata": { "pactSpecification": { "version": "4.0" } }
}
