<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.tpe</groupId>
        <artifactId>tiny_payment_engine</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>csm-gateway</artifactId>

    <properties>
        <!-- in the mutation score of specs/20-testing-strategy.md §7 -->
        <tpe.pit.skip>false</tpe.pit.skip>
    </properties>

    <dependencies>
        <!-- the csm.* messages (specs/02-messaging-contracts.md §3, §4) -->
        <dependency>
            <groupId>com.tpe</groupId>
            <artifactId>contracts</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tpe</groupId>
            <artifactId>payment-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- the ISO 20022 codec, validator and builders (specs/15-csm-gateway.md §2) -->
        <dependency>
            <groupId>com.tpe</groupId>
            <artifactId>iso20022-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- outbox and inbox (specs/15-csm-gateway.md §4, §5) -->
        <dependency>
            <groupId>com.tpe</groupId>
            <artifactId>messaging</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- tracing: the payment's trace is stored with the transfer and continued (ADR-014) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <!-- the admin API is for BACKOFFICE_OPERATOR (specs/15-csm-gateway.md §3.2) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <!-- the CSM client (specs/15-csm-gateway.md §2, infrastructure.csm) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tpe</groupId>
            <artifactId>test-support</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- MutableClock (specs/20-testing-strategy.md §2) -->
        <dependency>
            <groupId>com.tpe</groupId>
            <artifactId>payment-domain</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- the telemetry contract fixture (specs/26-observability.md §4) -->
        <dependency>
            <groupId>com.tpe</groupId>
            <artifactId>observability</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- P-06 and M-01, consumer csm-gateway (specs/20-testing-strategy.md §10.1, §10.2) -->
        <dependency>
            <groupId>au.com.dius.pact.consumer</groupId>
            <artifactId>junit5</artifactId>
        </dependency>
        <!-- provider verification of the pacts that name this service: M-02 of payment-orchestrator (20 §10.3) -->
        <dependency>
            <groupId>au.com.dius.pact.provider</groupId>
            <artifactId>junit5spring</artifactId>
        </dependency>
        <!-- csm-simulator in component tests -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- the default tpe.bank-directory.location, classpath:bank-directory.yml (specs/01-shared-libraries.md §1.4) -->
            <resource>
                <directory>${project.basedir}/../../deploy/config</directory>
                <includes>
                    <include>bank-directory.yml</include>
                </includes>
            </resource>
        </resources>
        <pluginManagement>
            <plugins>
                <!-- 20 §7: the answer coordinator and the send-by guard (on receipt and before every transmission, ADR-011) -->
                <plugin>
                    <groupId>org.pitest</groupId>
                    <artifactId>pitest-maven</artifactId>
                    <configuration>
                        <targetClasses>
                            <param>com.tpe.csmgateway.application.answer.AnswerCoordinator*</param>
                            <param>com.tpe.csmgateway.application.outgoing.CreditTransferSending*</param>
                            <param>com.tpe.csmgateway.application.outgoing.OutgoingTransmissions*</param>
                        </targetClasses>
                        <!-- these classes are exercised by the component tests only (Testcontainers, so the nightly
                             job needs Docker) -->
                        <targetTests>
                            <param>com.tpe.csmgateway.*IT</param>
                        </targetTests>
                        <excludedTestClasses combine.self="override"/>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
