{
  "interactiveLogin": false,
  "tokenCallbacks": [
    {
      "issuerId": "default",
      "tokenExpiry": 3600,
      "requestMappings": [
        {
          "requestParam": "accounts",
          "match": "*",
          "claims": {
            "sub": "${sub}",
            "client_id": "${clientId}",
            "scope": "${scope}",
            "accounts": ["${accounts}"]
          }
        },
        {
          "requestParam": "grant_type",
          "match": "client_credentials",
          "claims": {
            "sub": "${sub}",
            "client_id": "${clientId}",
            "scope": "${scope}",
            "accounts": []
          }
        }
      ]
    }
  ]
}
